# Copy the parts you want into your local `.env`.
# This repo's local web app currently reads env from the repo root.

# OpenClaw / AI Hire AI app base URL for absolute links in chat payloads
OPENCLAW_PUBLIC_BASE_URL=http://localhost:3002


# Discord companion bot bridge
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOW_DMS=true
DISCORD_REPLY_ONLY_ON_MENTION=false
OPENCLAW_DISCORD_SHARED_SECRET=

# OpenClaw agent used by the Discord bridge
OPENCLAW_AGENT=main
OPENCLAW_DISCORD_THINKING=low
OPENCLAW_DISCORD_AGENT_TIMEOUT_MS=120000
OPENCLAW_DISCORD_MAX_CONTEXT_MESSAGES=8
OPENCLAW_DISCORD_CONTEXT_TIMEOUT_MS=8000
OPENCLAW_DISCORD_RESUME_REVIEW_TIMEOUT_MS=25000
OPENCLAW_DISCORD_MAX_RESUME_CONTEXT_CHARS=12000

# Optional friendly persona override
# OPENCLAW_DISCORD_PERSONA=You are OpenClaw AI Hire AI Recruit on Discord...

# Opt-in proactive check-ins
OPENCLAW_DISCORD_PROACTIVE_ENABLED=false
OPENCLAW_DISCORD_PROACTIVE_CHANNEL_IDS=
OPENCLAW_DISCORD_PROACTIVE_IDLE_MINUTES=180
OPENCLAW_DISCORD_PROACTIVE_MIN_INTERVAL_MINUTES=360
OPENCLAW_DISCORD_PROACTIVE_MAX_PER_DAY=3
OPENCLAW_DISCORD_PROACTIVE_POLL_MINUTES=10

# STEPHEN.environment variables

AWS_BEARER_TOKEN_BEDROCK=
MODEL_REGION=us-east-1
NOVA_ACT_API=
AWS_PROFILE=local-iam
NOVA_ACT_WORKFLOW_NAME= 
NOVA_ACT_WORKFLOW_ARN= 
NOVA_ACT_MODEL_ID=nova-act-preview
S3_BUCKET= 
USE_REAL_NOVA_ACT=true
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
USE_REAL_BEDROCK=true

# OpenClaw webhook delivery for recruiter notifications
OPENCLAW_WEBHOOK_URL=
OPENCLAW_WEBHOOK_FORMAT=discord
OPENCLAW_DISCORD_WEBHOOK_URL=
OPENCLAW_DEFAULT_CHANNEL_ID=recruiter-social
OPENCLAW_DEFAULT_CONVERSATION_ID=discord-recruiter
# npm run test:openclaw-smoke


# Make sure a browser window actually shows
NOVA_ACT_HEADLESS=0


# Optional but useful for seeing what it’s doing
NOVA_ACT_DEBUG_LOGS=1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
NOVA_MODEL_ID= 
REDIS_URL=r 


PORT=3001
NODE_ENV=development


# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000


# NOVA_ACT_PREFER_CHROME=1
# NOVA_ACT_CHROME_PATH=/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
# NOVA_ACT_BROWSER_ARGS="--remote-debugging-port=9222"
# NOVA_ACT_BROWSER_ARGS="--remote-debugging-port=9222 --no-first-run --no-default-browser-check"
# NOVA_ACT_HEADLESS=false

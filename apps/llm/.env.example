# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────────
# CORS (comma-separated list of allowed origins)
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# LLM Provider Selection
# Options: "auto" (Nova first, Gemini fallback) | "nova" | "gemini"
# ─────────────────────────────────────────────
FORCE_LLM_PROVIDER=auto

# ─────────────────────────────────────────────
# Google Gemini (fallback LLM)
# Get from: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─────────────────────────────────────────────
# AWS Bedrock (Nova — primary LLM)
# Get from: https://console.aws.amazon.com → IAM → Access Keys
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
NOVA_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
USE_REAL_BEDROCK=false

# ─────────────────────────────────────────────
# Nova Act (agentic workflows — optional)
# Set USE_REAL_NOVA_ACT=true to activate real AWS workflows
# Leave false to use deterministic stubs (no AWS needed)
# ─────────────────────────────────────────────
USE_REAL_NOVA_ACT=false
NOVA_ACT_API=your_nova_act_api_key
NOVA_ACT_WORKFLOW_NAME=aihireai-act
NOVA_ACT_WORKFLOW_ARN=arn:aws:nova-act:us-east-1:your-account-id:workflow/your-workflow
NOVA_ACT_MODEL_ID=nova-act-preview
NOVA_ACT_HEADLESS=true
NOVA_ACT_DEBUG_LOGS=false

# ─────────────────────────────────────────────
# Redis (optional — caching layer)
# Leave blank to disable caching
# ─────────────────────────────────────────────
REDIS_URL=
REDIS_CACHE_TTL=3600

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─────────────────────────────────────────────
# S3 (optional — for storing agent run artifacts)
# ─────────────────────────────────────────────
S3_BUCKET=your_s3_bucket_name

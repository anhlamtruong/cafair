# ─────────────────────────────────────────────
# Database (Supabase PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:6543/postgres"

# ─────────────────────────────────────────────
# Supabase
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# ─────────────────────────────────────────────
# Clerk Authentication
# Get these from: https://dashboard.clerk.com → API Keys
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─────────────────────────────────────────────
# Internal Service URLs
# ─────────────────────────────────────────────
LLM_URL="http://localhost:3001"
NEXT_PUBLIC_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Google Calendar OAuth
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
# Add redirect URI: http://localhost:3000/api/google-calendar/callback (local)
#               or: https://your-domain.vercel.app/api/google-calendar/callback (production)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# ─────────────────────────────────────────────
# Google Maps (optional — used for event location display)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─────────────────────────────────────────────
# OpenWeather (optional — used for event weather display)
# Get from: https://openweathermap.org/api
# ─────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key
